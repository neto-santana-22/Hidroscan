# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email: console backend is appropriate for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@hidroscan.local

# Application settings
# The backend persists and returns instants in UTC. The frontend formats them
# for America/Recife.
TIME_ZONE=UTC

# Throttling and reverse proxy configuration:
# 0 for direct connection / development (evaluates REMOTE_ADDR directly, preventing X-Forwarded-For spoofing).
# In production behind a reverse proxy (e.g. NGINX, Cloudflare), set to the number of trusted upstream proxies (e.g. 1).
NUM_PROXIES=0
