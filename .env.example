# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email: console backend is appropriate for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@hidroscan.local

# Application settings
# The backend persists and returns instants in UTC. The frontend formats them
# for America/Recife.
TIME_ZONE=UTC
